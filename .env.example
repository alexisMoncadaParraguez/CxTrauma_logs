# Token para los endpoints protegidos (header X-API-Token)
API_TOKEN=cambia-esto

# Logs de Apache dentro del contenedor (montado desde /var/log/apache2).
# Verificar el nombre real del log del vhost de cx-trauma en el servidor.
APACHE_LOG_GLOB=/logs/access.log*
# LOG_FORMAT_REGEX=  (por defecto: formato combined)
ZONA_HORARIA=America/Santiago

# Incluir todos los rangos de AWS como "Amazon AWS (nube, no verificado)"
INCLUIR_AWS=false

# Google Data Manager API -> Google Analytics 4
GA4_PROPERTY_ID=123456789
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json
# true = solo valida (no ingesta). Pasar a false cuando el envío esté validado.
DM_VALIDATE_ONLY=true
DM_EVENT_NAME=bot_traffic_daily

# Job diario
SCHEDULER_ACTIVO=true
HORA_ENVIO=11:00
